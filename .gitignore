node_modules
dist/
.DS_Store

# 教材：pdf/<科目>/<版本>/ 里只收章节目录（*.目录树.json）；教材 PDF 版权归出版社，不入库（自己准备，见 README）。由 PDF 生成的书页贴图不入库
pdf/**
!pdf/**/
!pdf/**/*.目录树.json
public/books/*/hi
public/books/*/lo
public/books/*/mid
tools/*.private.txt
tools/figures.json

# 本地评审记录（大量带书页的截图）、浏览器调试
review/
tools/.browser-ws

# 样子用的课本页渲染图（有版权，不进仓库）
public/mock/

# pdf.js 的资源：npm run dev / build 前从 node_modules 拷过来
public/pdfjs/

# 离线版（node tools/build_offline.mjs 生成；部署时随网站放在 /offline.html）
dist-offline/
public/offline.html
